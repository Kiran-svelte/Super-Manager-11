# =============================================================================
# Super Manager - Environment Variables Template
# Copy to .env and fill in your values
# =============================================================================

# ===== Application Settings =====
APP_ENV=development
PORT=8000
HOST=0.0.0.0
SECRET_KEY=change-me-generate-with-openssl-rand-hex-32
FRONTEND_URL=http://localhost:3000

# ===== Database (Supabase - FREE) =====
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_supabase_anon_key_here

# ===== AI Providers =====
# Groq (FREE tier - primary)
GROQ_API_KEY=gsk_your-groq-key-here
GROQ_MODEL=llama-3.3-70b-versatile

# Gemini (FREE - fallback)
GEMINI_API_KEY=your-gemini-api-key

# SambaNova (FREE - fallback)
SAMBANOVA_API_KEY=your-sambanova-api-key

# OpenAI (paid, last fallback)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Ollama (local, FREE)
OLLAMA_BASE_URL=http://localhost:11434

# ===== Email (SMTP) =====
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Gmail OAuth 2.0 (optional, better than SMTP)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_USER=
GMAIL_REFRESH_TOKEN=

# ===== Telegram Bot =====
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ===== Security =====
RATE_LIMIT_PER_MINUTE=60

# ===== Monitoring =====
LOG_LEVEL=INFO
GRAFANA_PASSWORD=admin
