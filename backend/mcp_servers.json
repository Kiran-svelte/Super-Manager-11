{
  "_comment": "MCP (Model Context Protocol) Server Configurations",
  "_description": "Add MCP servers here to extend Super Manager with external tools and data sources",
  "_example": {
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github"],
      "env": {
        "GITHUB_TOKEN": "from_env"
      }
    },
    "filesystem": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "/path/to/allowed/directory"],
      "env": {}
    }
  },
  "servers": {}
}
